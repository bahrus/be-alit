{
  "name": "be-alit",
  "version": "0.0.4",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "JSON",
    "bind",
    "observe"
  ],
  "description": "Use the power of lit-html from HTML Markup.",
  "main": "be-alit.js",
  "module": "be-alit.js",
  "exports": {
    ".": "./be-alit.js",
    "./emc.js": "./emc.js",
    "./be-alit.js": "./be-alit.js",
    "./🎇.js": "./🎇.js"
  },
  "files": [
    "*.js",
    "./ts-refs/*"
  ],
  "types": "./ts-refs/be-alit/types.d.ts",
  "scripts": {
    "serve": "python3 ./node_modules/ssi-server/ssi_server.py",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:3030",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "lit-html": "3.2.1",
    "be-render-neutral": "0.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "be-kvetching": "0.0.4",
    "ssi-server": "0.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-alit.git"
  },
  "author": "anderson.bruce.b@gmail.com",
  "license": "MIT"
}
