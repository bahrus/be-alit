{
  "name": "be-alit",
  "version": "0.0.6",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "JSON",
    "bind",
    "observe"
  ],
  "description": "Use the power of lit-html from HTML Markup.",
  "main": "be-alit.js",
  "module": "be-alit.js",
  "exports": {
    ".": "./be-alit.js",
    "./emc.js": "./emc.js",
    "./be-alit.js": "./be-alit.js",
    "./🎇.js": "./🎇.js"
  },
  "files": [
    "*.js",
    "./ts-refs/*"
  ],
  "types": "./ts-refs/be-alit/types.d.ts",
  "scripts": {
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:3030",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "lit-html": "3.3.1",
    "be-render-neutral": "0.0.8",
    "mount-observer":"0.0.102"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "be-kvetching": "0.0.5",
    "spa-ssi": "0.0.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-alit.git"
  },
  "author": "anderson.bruce.b@gmail.com",
  "license": "MIT"
}
